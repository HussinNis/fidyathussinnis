<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="أهلاً بك"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <Button
                android:id="@+id/btnCart"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="🛒 0"
                android:textSize="18sp"
                android:textColor="#111827"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:text="🚪"
                android:textSize="20sp"
                android:textColor="#111827"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سعر الفضة المباشر"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSilverPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سعر جرام الفضة: --"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="آخر تحديث: --"
                android:textSize="14sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أقسام المتجر"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnBars"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="السبائك"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAccessories"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="الإكسسوارات"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCalculator"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="الحاسبة"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOrders"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="الطلبات"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>
</ScrollView>