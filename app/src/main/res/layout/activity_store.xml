<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvWelcomeUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="أهلاً بك"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCart"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🛒 0"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🚪"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSilverPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سعر جرام الفضة: --"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvLastUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="آخر تحديث: --"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="السبائك"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAccessories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الإكسسوارات"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCalculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الحاسبة" />

</LinearLayout>